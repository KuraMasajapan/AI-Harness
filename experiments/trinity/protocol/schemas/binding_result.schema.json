{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRINITY V0.1 binding_result",
  "type": "object",
  "properties": {
    "candidate_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "result",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "candidate_artifact_id",
    "result",
    "checks"
  ],
  "additionalProperties": false
}
