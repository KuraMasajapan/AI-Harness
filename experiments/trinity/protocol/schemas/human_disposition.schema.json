{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRINITY V0.1 human_disposition",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "ACCEPT_WITH_EXPLICIT_SELECTION",
        "DEFER",
        "NO_DECISION"
      ]
    },
    "accepted_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejected_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deferred_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "decision",
    "accepted_items",
    "rejected_items",
    "deferred_items",
    "notes"
  ],
  "additionalProperties": false
}
